# ===== Supabase (frontend) =====
# These two are PUBLIC — safe to commit. They only grant access through RLS.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ===== OpenRouter (Supabase secret) =====
# NEVER put this in VITE_* or anywhere the browser can see it.
# Set it in: Supabase Dashboard → Edge Functions → Secrets
#   key:   OPENROUTER_API_KEY
#   value: sk-or-v1-...
